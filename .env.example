# EPM Market Intelligence — environment template.
# Copy to .env and fill in. .env is gitignored; this template is committed.
# Only the email-subscription + sender vars are documented here; other runtime
# keys (news APIs, AV_API_KEY, JWT_SECRET, etc.) live in your private .env.

# --- Cookie / auth ---
# true in production (HTTPS); set false for local HTTP dev or login silently fails.
SECURE_COOKIES=true

# --- Outbound email (Plan 1) ---
# Transactional sender on the domain. When RESEND_API_KEY is set the mailer uses
# Resend SMTP; otherwise it falls back to the legacy Gmail app-password path.
RESEND_API_KEY=
MAIL_FROM=EPM Market Intelligence <reports@epm-market-intelligence.com>
# Optional SMTP overrides (defaults: smtp.resend.com / 465 / resend when Resend is active)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
# Legacy fallback (used only when RESEND_API_KEY is empty)
GMAIL_APP_PASSWORD=

# Physical postal address shown in the daily-email footer (CAN-SPAM requirement).
MAIL_PHYSICAL_ADDRESS=EPM Financial, <street>, <city, ST ZIP>

# Failure alerts: run_daily.py emails this address when the daily run fails.
# Also used by the server-side watchdog (watchdog_service.py) to alert when
# the daily report is missing after the cutoff on a market day.
# REQUIRED on the server — add to /opt/epm-market-intelligence/.env.
ALERT_EMAIL=davidporter0731@gmail.com

# Server-side watchdog controls (watchdog_service.py)
# Set WATCHDOG_ENABLED=0 on laptop dev runs to suppress the watchdog thread.
WATCHDOG_ENABLED=1
# Seconds between watchdog polls (default 600 = 10 minutes).
WATCHDOG_INTERVAL_SEC=600
# HH:MM US Central time after which a missing report triggers an alert.
WATCHDOG_STALE_CUTOFF=10:30

# --- Email links + subscriber list (Plan 1) ---
# Public origin used to build confirm/unsubscribe links in emails. MUST be the
# public domain in production so links don't point at an internal host.
PUBLIC_BASE_URL=https://epm-market-intelligence.com

# Shared secret guarding GET /api/internal/daily-recipients. The laptop pipeline
# sends it as the X-Internal-Key header. If unset, the endpoint is disabled (403)
# and the daily email goes only to the always-on internal recipient.
INTERNAL_API_KEY=

# --- Laptop pipeline send (send_email.py) ---
# Always-on internal recipient (gets every daily email, no unsubscribe link).
INTERNAL_RECIPIENT=dporter@epmfinancial.com
# Where the laptop fetches the confirmed-subscriber list (server, over Tailscale).
EPM_SERVER_URL=http://100.101.63.65:8000
# Override the full URL if the path/port differs:
# INTERNAL_RECIPIENTS_URL=http://100.101.63.65:8000/api/internal/daily-recipients

# --- Deep-analysis web-research enrichment (funds + stocks) ---
# Self-hosted SearxNG JSON endpoint (see deploy/searxng/). Until it is running,
# enrichment no-ops and symbols still get the rest of the analysis.
SEARXNG_URL=http://127.0.0.1:8080
# Join timeout (seconds) for the concurrent research thread in build_seed_doc.
# (PM_RESEARCH_TIMEOUT_SEC kept as a fallback for back-compat.)
RESEARCH_TIMEOUT_SEC=120
# Fast model used for grounded extraction (NOT the slow council model). Defaults
# to CHAT_OLLAMA_MODEL (qwen3.5:4b) at LOCAL_OLLAMA_URL.
RESEARCH_OLLAMA_MODEL=
# Server-managed research cache location (created on first write; never synced).
RESEARCH_DB_PATH=research_cache.db
